# ==========================================
# TempMail Ultra-Light — Environment Variables
# ==========================================

# --- Database (SQLite by default, PostgreSQL optional) ---
# DB_DRIVER=sqlite (default) or postgres
DB_DRIVER=sqlite
DB_PATH=data/tempmail.db

# For PostgreSQL:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=tempmail
# DB_PASSWORD=your_password
# DB_NAME=tempmail

# --- JWT Authentication (REQUIRED) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- Server ---
PORT=8080
GIN_MODE=release

# --- SMTP Server (built-in, replaces Maddy) ---
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_MAX_SIZE=10485760

# --- Domains (comma-separated) ---
DOMAINS=example.com
SITE_NAME=TempMail

# --- CORS (comma-separated, empty = same-origin only) ---
# Example: https://mail.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Cleanup ---
CLEANUP_INTERVAL=1h
MESSAGE_RETENTION=24h

# --- Attachments ---
ATTACHMENTS_DIR=data/attachments

# --- Webhook (optional) ---
# URL to POST to when email is received
WEBHOOK_URL=

# --- Cloudflare Email Worker (optional — no port 25 needed) ---
# API key that the Cloudflare Worker uses to authenticate to /api/email/receive
EMAIL_API_KEY=
# Your VPS public URL (used by Worker to reach this server)
SERVER_URL=
# Batas ukuran satu email yang diterima (byte). Default 5 MiB, berlaku untuk Worker dan SMTP.
MAX_RAW_EMAIL_BYTES=5242880
# Kalau diisi, Worker wajib mengirim header X-Email-Signature (HMAC-SHA256 body) dan
# panel akan menaruh nilai ini sebagai secret TEMPMAIL_SIGNING_SECRET saat deploy Worker.
WORKER_SIGNING_SECRET=

# --- Cloudflare control panel (web admin panel) ---
# Base URL for Cloudflare REST calls; override only for testing or staging.
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Worker script name, compatibility date, and tunnel name used by the panel.
CF_WORKER_NAME=tempmailbyjhopanstore
CF_WORKER_COMPAT_DATE=2024-01-01
CF_TUNNEL_NAME=tempmailbyjhopanstore

# --- Root helper (restart service, backup, logs, tunnel) ---
# Spool directory written by the app and consumed by the root helper units.
HELPER_DIR=/opt/tempmail/data/helper
# Seconds the panel waits for a helper answer before reporting a timeout.
HELPER_WAIT_SECONDS=25

# --- Rate Limiting ---
RATE_LIMIT_API=60
RATE_LIMIT_DELETE=20

# --- Admin seed (first boot only) ---
# Seed dijalankan lewat POST /api/setup, bukan dari env ini.
# ADMIN_EMAIL hanya dipakai skrip/menu sebagai petunjuk akun admin.
# Password admin tidak disimpan di file ini; menu dan setup menanyakannya saat login.
ADMIN_EMAIL=
