# ==========================================
# TempMail Ultra-Light — Environment Variables
# ==========================================

# --- Database (SQLite by default, PostgreSQL optional) ---
# DB_DRIVER=sqlite (default) or postgres
DB_DRIVER=sqlite
DB_PATH=data/tempmail.db

# For PostgreSQL:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=tempmail
# DB_PASSWORD=your_password
# DB_NAME=tempmail

# --- JWT Authentication (REQUIRED) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- Server ---
PORT=8080
GIN_MODE=release

# --- SMTP Server (built-in, replaces Maddy) ---
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_MAX_SIZE=10485760

# --- Domains (comma-separated) ---
DOMAINS=example.com
SITE_NAME=TempMail

# --- CORS (comma-separated, empty = same-origin only) ---
# Example: https://mail.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Cleanup ---
CLEANUP_INTERVAL=1h
MESSAGE_RETENTION=24h

# --- Attachments ---
ATTACHMENTS_DIR=data/attachments

# --- Webhook (optional) ---
# URL to POST to when email is received
WEBHOOK_URL=

# --- Cloudflare Email Worker (optional — no port 25 needed) ---
# API key that the Cloudflare Worker uses to authenticate to /api/email/receive
EMAIL_API_KEY=
# Your VPS public URL (used by Worker to reach this server)
SERVER_URL=

# --- Rate Limiting ---
RATE_LIMIT_API=60
RATE_LIMIT_DELETE=20

# --- Admin seed (first boot only) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme123
