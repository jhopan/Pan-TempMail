# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=tempmail
DB_PASSWORD=***
# --- JWT Authentication ---
JWT_SECRET=your-s...-here-min-32-chars
JWT_EXPIRY_HOURS=24

# --- Server ---
PORT=8080
LMTP_PORT=8024

# --- Rate Limiting ---
RATE_LIMIT_API=60
RATE_LIMIT_DELETE=20

# --- Domains (comma separated) ---
DOMAINS=renunganbot.qzz.io

# --- Cloudflare (for add-domain.sh) ---
# CF_API_TOKEN=*** CF_ACCOUNT_ID=your_...unt_id_here
