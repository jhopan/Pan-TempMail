# Normalize all text files to LF on checkout; committed bytes stay LF.
* text=auto eol=lf

# Files that must be reviewed/diffed as LF text.
*.go       text eol=lf
*.js       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.path     text eol=lf
*.sql      text eol=lf
Dockerfile text eol=lf

# Archives and images: never diff, never normalize.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.gz binary
*.zip binary
