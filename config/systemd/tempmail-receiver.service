[Unit]
Description=Temp Mail Receiver (Go API + LMTP)
After=network.target postgresql.service maddy.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mail-platform/receiver
ExecStart=/opt/mail-platform/receiver/receiver-final
Restart=always
RestartSec=5
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
