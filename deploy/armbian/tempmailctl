#!/usr/bin/env bash
# TempMail By JhopanStore control panel. Run: menutempmail (or sudo tempmailctl)
set -euo pipefail

APP=/opt/tempmail
ENV_DIR=/etc/tempmail
APP_ENV=$ENV_DIR/tempmail.env
CF_ENV=$ENV_DIR/cloudflare.env
WORKER_DIR=$APP/worker
TUNNEL_NAME=tempmail-armbian

need_root() {
  [ "$(id -u)" = 0 ] || { echo "Run: sudo tempmailctl"; exit 1; }
}

load_cf() {
  [ -f "$CF_ENV" ] && . "$CF_ENV"
  EMAIL_DOMAINS=${EMAIL_DOMAINS:-${EMAIL_DOMAIN:-}}
  EMAIL_DOMAIN=${EMAIL_DOMAINS%%,*}
  WEB_HOST=${WEB_HOST:-}
  COPY_DESTINATIONS=${COPY_DESTINATIONS:-}
  TUNNEL_ID=${TUNNEL_ID:-}
  WRANGLER_ACCOUNT=${WRANGLER_ACCOUNT:-}
  TUNNEL_ACCOUNT=${TUNNEL_ACCOUNT:-}
  WORKER_DEPLOYED=${WORKER_DEPLOYED:-no}
  EMAIL_ROUTING=${EMAIL_ROUTING:-no}
}

save_cf() {
  umask 077
  cat >"$CF_ENV" <<EOF
EMAIL_DOMAINS=$EMAIL_DOMAINS
WEB_HOST=$WEB_HOST
COPY_DESTINATIONS=$COPY_DESTINATIONS
TUNNEL_ID=$TUNNEL_ID
WRANGLER_ACCOUNT=$WRANGLER_ACCOUNT
TUNNEL_ACCOUNT=$TUNNEL_ACCOUNT
WORKER_DEPLOYED=$WORKER_DEPLOYED
EMAIL_ROUTING=$EMAIL_ROUTING
EOF
}

set_app_env() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp)
  grep -v "^${key}=" "$APP_ENV" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  install -o root -g tempmail -m 0640 "$tmp" "$APP_ENV"
  rm -f "$tmp"
}

dashboard() {
  load_cf
  local service backup tunnel rss inboxes messages last_backup domains wrangler_state tunnel_state
  service=$(systemctl is-active tempmail 2>/dev/null || true)
  backup=$(systemctl is-active tempmail-backup.timer 2>/dev/null || true)
  tunnel=$(systemctl is-active cloudflared 2>/dev/null || true)
  rss=$(ps -o rss= -C tempmail 2>/dev/null | awk 'NR==1 {printf "%.1f MiB", $1/1024}')
  inboxes=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM inboxes;' 2>/dev/null || echo 0)
  messages=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM messages;' 2>/dev/null || echo 0)
  last_backup=$(find "$APP/backups" -maxdepth 1 -type f -name 'tempmail-*.db' -printf '%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null | sort | tail -1)
  domains=$(grep '^DOMAINS=' "$APP_ENV" 2>/dev/null | cut -d= -f2-)
  [ -n "$domains" ] || domains='belum diatur'
  [ -n "$last_backup" ] || last_backup='belum ada'
  [ -n "$WRANGLER_ACCOUNT" ] && wrangler_state="login: $WRANGLER_ACCOUNT" || wrangler_state='belum login'
  [ -n "$TUNNEL_ACCOUNT" ] && tunnel_state="login: $TUNNEL_ACCOUNT" || tunnel_state='belum login'

  echo '=== TempMail By JhopanStore ==='
  printf 'TempMail       : %s | %s\n' "${service:-inactive}" "${rss:-0 MiB}"
  printf 'Web LAN        : http://192.168.11.23:8080/app/\n'
  printf 'Domain TempMail: %s\n' "$domains"
  printf 'Inbox          : %s inbox | %s message\n' "$inboxes" "$messages"
  printf 'SQLite backup  : %s | last: %s\n' "${backup:-inactive}" "$last_backup"
  printf 'Wrangler       : %s\n' "$wrangler_state"
  printf 'CF Tunnel      : %s | %s\n' "$tunnel_state" "${tunnel:-not configured}"
  printf 'Tunnel name    : %s\n' "$TUNNEL_NAME"
  printf 'Tunnel UUID    : %s\n' "${TUNNEL_ID:-belum dibuat}"
  printf 'Web hostname   : %s\n' "${WEB_HOST:-belum diatur}"
  printf 'Worker         : %s\n' "$( [ "$WORKER_DEPLOYED" = yes ] && echo 'deployed' || echo 'belum deploy' )"
  printf 'Email Routing  : %s\n' "$( [ "$EMAIL_ROUTING" = yes ] && echo "active: *@[$EMAIL_DOMAINS]" || echo 'belum diatur' )"
  printf 'Salinan email  : %s\n' "${COPY_DESTINATIONS:-OFF}"
}

ensure_worker_tools() {
  if ! command -v npm >/dev/null 2>&1; then
    echo "Installing Node.js and npm for Wrangler..."
    apt-get update -qq
    apt-get install -y -qq nodejs npm
  fi
}

configure_domain() {
  load_cf
  read -r -p "Domain email, pisahkan koma bila banyak [$EMAIL_DOMAINS]: " input_domains
  EMAIL_DOMAINS=${input_domains:-$EMAIL_DOMAINS}
  [ -n "$EMAIL_DOMAINS" ] || { echo "Minimal satu domain diperlukan."; return; }
  EMAIL_DOMAIN=${EMAIL_DOMAINS%%,*}
  read -r -p "Hostname web [mail.$EMAIL_DOMAIN]: " input_web
  WEB_HOST=${input_web:-mail.$EMAIL_DOMAIN}
  save_cf
  set_app_env DOMAINS "$EMAIL_DOMAINS"
  systemctl restart tempmail
  echo "Saved. TempMail menerima: @$EMAIL_DOMAINS"
}

manage_copy_destinations() {
  load_cf
  echo "Tujuan salinan sekarang: ${COPY_DESTINATIONS:-OFF}"
  read -r -p "Email tujuan, pisahkan koma. Kosongkan untuk OFF: " input
  COPY_DESTINATIONS=$input
  save_cf
  echo "Tersimpan. Pilih Deploy/update Worker agar Cloudflare memakai perubahan ini."
}

wrangler_login() {
  ensure_worker_tools
  [ -d "$WORKER_DIR" ] || { echo "Worker files missing: $WORKER_DIR"; return; }
  echo "Browser login URL will appear. Open it, login Cloudflare, click Allow."
  (cd "$WORKER_DIR" && npx wrangler login)
  local info
  info=$(cd "$WORKER_DIR" && npx wrangler whoami 2>/dev/null || true)
  WRANGLER_ACCOUNT=$(printf '%s\n' "$info" | sed -n 's/^.*Account Name: *//p' | head -1)
  [ -n "$WRANGLER_ACCOUNT" ] || WRANGLER_ACCOUNT='logged in'
  save_cf
}

wrangler_whoami() {
  ensure_worker_tools
  (cd "$WORKER_DIR" && npx wrangler whoami)
}

tunnel_login() {
  echo "Browser login URL will appear. Open it, login Cloudflare, select your active domain."
  cloudflared tunnel login
  read -r -p "Cloudflare account email/name used for tunnel (status label only): " TUNNEL_ACCOUNT
  [ -n "$TUNNEL_ACCOUNT" ] || TUNNEL_ACCOUNT='logged in'
  save_cf
}

create_tunnel() {
  load_cf
  [ -n "$WEB_HOST" ] || { echo "Configure domain first."; return; }
  [ -f /root/.cloudflared/cert.pem ] || { echo "Tunnel login required first."; return; }

  local list name id config
  list=$(cloudflared tunnel list --output json)
  id=$(python3 - "$TUNNEL_NAME" "$list" <<'PY'
import json, sys
name, data = sys.argv[1:]
for item in json.loads(data):
    if item['name'] == name:
        print(item['id'])
        break
PY
)
  if [ -z "$id" ]; then
    cloudflared tunnel create "$TUNNEL_NAME"
    list=$(cloudflared tunnel list --output json)
    id=$(python3 - "$TUNNEL_NAME" "$list" <<'PY'
import json, sys
name, data = sys.argv[1:]
for item in json.loads(data):
    if item['name'] == name:
        print(item['id'])
        break
PY
)
  fi
  [ -n "$id" ] || { echo "Could not create/find tunnel."; return; }

  TUNNEL_ID=$id
  save_cf
  install -d -m 0755 /etc/cloudflared
  cat >/etc/cloudflared/config.yml <<EOF
 tunnel: $TUNNEL_ID
 credentials-file: /root/.cloudflared/$TUNNEL_ID.json

 ingress:
   - hostname: $WEB_HOST
     service: http://127.0.0.1:8080
   - service: http_status:404
EOF
  sed -i 's/^ //' /etc/cloudflared/config.yml
  cloudflared tunnel route dns "$TUNNEL_NAME" "$WEB_HOST"
  cloudflared service install
  systemctl enable --now cloudflared
  echo "Tunnel active: https://$WEB_HOST/app/"
}

deploy_worker() {
  load_cf
  [ -n "$WEB_HOST" ] || { echo "Configure domain and tunnel first."; return; }
  [ -d "$WORKER_DIR" ] || { echo "Worker files missing."; return; }
  ensure_worker_tools

  local api_key
  api_key=$(grep '^EMAIL_API_KEY=' "$APP_ENV" | cut -d= -f2-)
  if [ -z "$api_key" ]; then
    api_key=$(openssl rand -hex 32)
    set_app_env EMAIL_API_KEY "$api_key"
  fi
  (cd "$WORKER_DIR" && \
    printf '%s\n' "https://$WEB_HOST" | npx wrangler secret put TEMPMAIL_SERVER_URL && \
    printf '%s\n' "$api_key" | npx wrangler secret put TEMPMAIL_API_KEY && \
    printf '%s\n' "$COPY_DESTINATIONS" | npx wrangler secret put FORWARD_LIST && \
    npx wrangler deploy)
  WORKER_DEPLOYED=yes
  save_cf
  systemctl restart tempmail
  echo "Worker deployed. Salinan email: ${COPY_DESTINATIONS:-OFF}"
}

enable_email_routing() {
  load_cf
  [ -n "$EMAIL_DOMAINS" ] || { echo "Configure domain first."; return; }
  echo "Need API Token: Zone Read, DNS Edit, Email Routing Edit, Workers Scripts Edit."
  read -r -s -p "Cloudflare API token (not saved): " token; echo
  [ -n "$token" ] || return
  read -r -p "WARNING: route ALL *@[$EMAIL_DOMAINS] to Worker tempmail-email-worker? [y/N]: " yes
  [ "$yes" = y ] || { echo "Cancelled."; return; }

  CF_TOKEN="$token" DOMAINS="$EMAIL_DOMAINS" python3 - <<'PY'
import json, os
from urllib.request import Request, urlopen

base = 'https://api.cloudflare.com/client/v4'
token = os.environ['CF_TOKEN']
domains = [item.strip() for item in os.environ['DOMAINS'].split(',') if item.strip()]
def call(method, path, body=None):
    req = Request(base + path, method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'})
    with urlopen(req, timeout=30) as response:
        data = json.load(response)
    if not data.get('success'):
        raise RuntimeError(json.dumps(data.get('errors', data)))
    return data['result']

body = {'name':'TempMail catch-all', 'enabled':True,
        'actions':[{'type':'worker', 'value':['tempmail-email-worker']}],
        'matchers':[{'type':'all'}]}
for domain in domains:
    zones = call('GET', '/zones?name=' + domain)
    if not zones or zones[0].get('status') != 'active':
        raise SystemExit('Zone missing or not Active: ' + domain)
    zid = zones[0]['id']
    try:
        call('POST', f'/zones/{zid}/email/routing/enable', {})
    except RuntimeError:
        pass
    call('PUT', f'/zones/{zid}/email/routing/rules/catch_all', body)
    print('Email Routing active: *@' + domain)
PY
  EMAIL_ROUTING=yes
  save_cf
  [ -n "$COPY_DESTINATIONS" ] && echo "Verify each email tujuan salinan in Cloudflare before using it."
}

status() {
  dashboard
  [ -n "$WEB_HOST" ] && curl -fsS "https://$WEB_HOST/health" && echo || true
}

full_setup() {
  configure_domain
  echo "\nStep 1/5: Wrangler login"
  wrangler_login
  echo "\nStep 2/5: Tunnel login"
  tunnel_login
  echo "\nStep 3/5: Create tunnel"
  create_tunnel
  echo "\nStep 4/5: Deploy Worker"
  deploy_worker
  echo "\nStep 5/5: Email Routing"
  enable_email_routing
  status
}

main() {
  need_root
  while true; do
    dashboard
    echo
    echo "=== Control Panel ==="
    echo "1. Login Wrangler Cloudflare"
    echo "2. Login Cloudflare Tunnel"
    echo "3. Atur satu/lebih domain TempMail + hostname web"
    echo "4. Atur tujuan salinan email (default OFF)"
    echo "5. AUTO SETUP Cloudflare setelah login"
    echo "6. Deploy/update Email Worker + secret"
    echo "7. Aktifkan Email Routing catch-all"
    echo "8. Refresh status"
    echo "0. Exit"
    read -r -p "Choose: " choice
    case "$choice" in
      1) wrangler_login ;; 2) tunnel_login ;; 3) configure_domain ;;
      4) manage_copy_destinations ;; 5) full_setup ;; 6) deploy_worker ;;
      7) enable_email_routing ;; 8) status ;; 0) exit 0 ;; *) echo "Invalid option." ;;
    esac
  done
}

main "$@"
