#!/usr/bin/env bash
# TempMail By JhopanStore control panel. Run: menutempmail
set -euo pipefail

APP=/opt/tempmail
ENV_DIR=/etc/tempmail
APP_ENV=$ENV_DIR/tempmail.env
STATE=$ENV_DIR/cloudflare-state.json
HELPER_IN=$APP/data/helper/in
TUNNEL_NAME=tempmailbyjhopanstore

need_root() {
  [ "$(id -u)" = 0 ] || { echo "Run: menutempmail"; exit 1; }
}

# Menu mengurai JSON lewat python3; tanpa itu pesan errornya menyesatkan.
require_python() {
  command -v python3 >/dev/null 2>&1 || {
    echo "python3 wajib ada untuk menu ini. Pasang: apt-get install -y python3" >&2
    exit 1
  }
}

app_port() {
  local p
  p=$(grep '^PORT=' "$APP_ENV" 2>/dev/null | cut -d= -f2)
  echo "${p:-8080}"
}

# ─── Klien admin API lokal ───────────────────────────────────────────────────
# Database di app adalah sumber data tunggal untuk profil, domain, Worker,
# routing, copy, dan tunnel. Menu ini hanya klien tipis; kerja root
# (cloudflared, service) tetap di bash.
TM_JWT=""
TM_BODY=""
TM_CODE=""

api_base() {
  if [ -n "${TM_API_BASE:-}" ]; then
    printf '%s' "${TM_API_BASE%/}"
  else
    printf 'http://127.0.0.1:%s' "$(app_port)"
  fi
}

# Login admin. Kredensial diambil dari env file bila ada, kalau tidak ditanya
# sekali per sesi menu. JWT hanya hidup di variabel shell, tidak ditulis ke disk
# dan tidak pernah dicetak. TM_NO_PROMPT=1 mematikan pertanyaan (dipakai saat
# membuka menu supaya tidak menanyakan password di awal).
api_login() {
  [ -n "$TM_JWT" ] && return 0
  local email pass body out token
  email=$(grep '^ADMIN_EMAIL=' "$APP_ENV" 2>/dev/null | cut -d= -f2- || true)
  pass=$(grep '^ADMIN_PASS=' "$APP_ENV" 2>/dev/null | cut -d= -f2- || true)
  if [ -z "$email" ]; then
    if [ -n "${TM_ADMIN_EMAIL:-}" ]; then
      email="$TM_ADMIN_EMAIL"
    elif [ -t 0 ] && [ "${TM_NO_PROMPT:-0}" != "1" ]; then
      read -r -p "Email admin: " email
    fi
  fi
  if [ -z "$pass" ]; then
    if [ -n "${TM_ADMIN_PASS:-}" ]; then
      pass="$TM_ADMIN_PASS"
    elif [ -t 0 ] && [ "${TM_NO_PROMPT:-0}" != "1" ]; then
      read -r -s -p "Password admin (tidak ditampilkan): " pass
      echo
    fi
  fi
  if [ -z "$email" ] || [ -z "$pass" ]; then
    echo "Kredensial admin belum tersedia." >&2
    echo "Jalankan menu dari terminal supaya bisa ditanya, set TM_ADMIN_EMAIL/TM_ADMIN_PASS, atau reset lewat panel /admin -> Pengguna." >&2
    return 1
  fi
  body=$(TM_EMAIL="$email" TM_PASS="$pass" python3 -c '
import json, os
print(json.dumps({"email": os.environ["TM_EMAIL"], "password": os.environ["TM_PASS"]}))
')
  if ! out=$(printf '%s' "$body" | curl -sS -m 15 -w '\n%{http_code}' -X POST "$(api_base)/api/auth/login" \
      -H 'Content-Type: application/json' --data-binary @- 2>/dev/null); then
    echo "Tidak bisa menghubungi API di $(api_base). Cek: systemctl status tempmail" >&2
    return 1
  fi
  token=$(printf '%s' "$out" | python3 -c '
import json, sys
raw = sys.stdin.read()
body, _, code = raw.rpartition("\n")
if code.strip() != "200":
    sys.exit(1)
try:
    print(json.loads(body).get("token", ""))
except Exception:
    sys.exit(1)
' 2>/dev/null || true)
  if [ -z "$token" ]; then
    echo "Login API gagal (HTTP ${out##*$'\n'}). Set ulang password admin lewat menu A bila kredensial salah." >&2
    return 1
  fi
  TM_JWT=$token
}

# Panggil API, simpan badan jawaban di TM_BODY dan status di TM_CODE.
api_raw() {
  local method=$1 path=$2 data=${3:-} timeout=${4:-30} out
  TM_BODY=""
  TM_CODE=""
  api_login || return 1
  if [ -n "$data" ]; then
    # Badan dikirim lewat stdin: token/password tidak muncul di daftar proses (ps).
    out=$(printf '%s' "$data" | curl -sS -m "$timeout" -w '\n%{http_code}' -X "$method" "$(api_base)$path" \
      -H "Authorization: Bearer $TM_JWT" -H 'Content-Type: application/json' \
      --data-binary @- 2>/dev/null) || out=""
  else
    out=$(curl -sS -m "$timeout" -w '\n%{http_code}' -X "$method" "$(api_base)$path" \
      -H "Authorization: Bearer $TM_JWT" 2>/dev/null) || out=""
  fi
  if [ -z "$out" ]; then
    echo "Tidak bisa menghubungi API $(api_base)$path. Cek: systemctl status tempmail" >&2
    return 1
  fi
  TM_CODE=${out##*$'\n'}
  TM_BODY=${out%$'\n'*}
  return 0
}

api_is_ok() {
  case "${TM_CODE:-}" in
    2*) return 0 ;;
    *) return 1 ;;
  esac
}

# Cetak field error + detail apa adanya (mis. pesan Cloudflare di "detail").
api_error() {
  local msg
  msg=$(printf '%s' "$TM_BODY" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
msg = d.get("error") or ""
detail = d.get("detail") or ""
if msg and detail:
    print(str(msg) + ": " + str(detail))
else:
    print(str(msg or detail))
' 2>/dev/null || true)
  [ -n "$msg" ] || msg="Permintaan API gagal (HTTP ${TM_CODE:-000})"
  echo "  GAGAL: $msg" >&2
}

# api_call METHOD PATH [JSON] [TIMEOUT]: diam saat 2xx, cetak error saat gagal.
api_call() {
  api_raw "$@" || return 1
  api_is_ok && return 0
  api_error
  return 1
}

# api_json: cetak badan JSON untuk diurai python3.
api_json() {
  api_raw "$@" || return 1
  if api_is_ok; then
    printf '%s' "$TM_BODY"
    return 0
  fi
  api_error
  return 1
}

# tm_json field ENVVAR [field ENVVAR ...]: JSON satu baris tanpa meneruskan
# nilai sensitif lewat argv (ps).
tm_json() {
  python3 -c '
import json, os, sys
args = sys.argv[1:]
out = {}
for i in range(0, len(args), 2):
    out[args[i]] = os.environ.get(args[i + 1], "")
print(json.dumps(out))
' "$@"
}

ensure_state() {
  install -d -o root -g root -m 0700 "$ENV_DIR"
  if [ ! -f "$STATE" ]; then
    printf '{"active_profile":"","profiles":{},"domains":{},"tunnel":{"id":"","account":"","web_hosts":[]}}\n' >"$STATE"
    chmod 600 "$STATE"
  fi
}

state_get() {
  python3 - "$STATE" "$@" <<'PY'
import json, sys
state, path = sys.argv[1], sys.argv[2:]
data = json.load(open(state))
for key in path:
    data = data.get(key, '') if isinstance(data, dict) else ''
print(data if not isinstance(data, (dict, list)) else json.dumps(data))
PY
}

refresh_app_domains() {
  # DOMAINS hanya fallback: app membaca domain dari database, jadi tidak perlu restart.
  local domains
  if ! domains=$(api_json GET /api/admin/cloudflare/domains | python3 -c '
import json, sys
items = json.load(sys.stdin)
print(",".join(sorted(d["domain"] for d in items if d.get("enabled") and d.get("routing"))))
'); then
    return 0
  fi
  [ -n "$domains" ] || domains=local.invalid
  set_app_env DOMAINS "$domains"
  echo "DOMAINS=$domains (fallback env; database tetap sumber utama)."
}

set_app_env() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp)
  grep -v "^${key}=" "$APP_ENV" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  install -o root -g tempmail -m 0640 "$tmp" "$APP_ENV"
  rm -f "$tmp"
}

# Buang ADMIN_PASS plaintext dari env file; password hanya ditanya saat login.
drop_admin_pass() {
  local env_file=$1 tmp
  grep -q '^ADMIN_PASS=' "$env_file" 2>/dev/null || return 0
  tmp=$(mktemp)
  grep -v '^ADMIN_PASS=' "$env_file" >"$tmp"
  install -o root -g tempmail -m 0640 "$tmp" "$env_file"
  rm -f "$tmp"
  echo "  ADMIN_PASS dihapus dari $env_file"
}

active_profile() {
  local profiles
  profiles=$(api_json GET /api/admin/cloudflare/profiles) || return 1
  printf '%s' "$profiles" | python3 -c '
import json, sys
for p in json.load(sys.stdin):
    if p.get("active"):
        print(p.get("id", ""))
        break
'
}

choose_profile() {
  local profile
  profile=$(active_profile) || { echo "Status Cloudflare tidak bisa dibaca dari API." >&2; return 1; }
  if [ -z "$profile" ]; then
    echo "Belum ada akun Cloudflare. Tambahkan dari menu akun." >&2
    return 1
  fi
  printf '%s' "$profile"
}

add_cf_profile() {
  local name account token label payload
  read -r -p "ID profil (contoh: cf-a, cf-b): " name
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "ID hanya huruf/angka/-/_"; return 0; }
  read -r -p "Label akun (contoh: Cloudflare A): " label
  read -r -p "Cloudflare Account ID: " account
  read -r -s -p "Cloudflare API Token (disimpan terenkripsi di database): " token; echo
  [ -n "$name" ] && [ -n "$account" ] && [ -n "$token" ] || { echo "Data wajib diisi."; return 0; }
  payload=$(CF_ID="$name" CF_LABEL="$label" CF_ACCOUNT="$account" CF_TOKEN="$token" \
    tm_json id CF_ID label CF_LABEL account_id CF_ACCOUNT token CF_TOKEN)
  api_call POST /api/admin/cloudflare/profiles "$payload" 60 || return 0
  echo "Profil $name tersimpan di database. Token tidak ditampilkan dashboard."
}

select_cf_profile() {
  local selected profiles
  profiles=$(api_json GET /api/admin/cloudflare/profiles) || return 0
  printf '%s' "$profiles" | python3 -c '
import json, sys
for p in json.load(sys.stdin):
    pid = p.get("id") or ""
    print(pid + "\t" + (p.get("label") or pid))
'
  read -r -p "Pilih ID profil: " selected
  [ -n "$selected" ] || return 0
  api_call POST "/api/admin/cloudflare/profiles/$selected/activate" || return 0
  echo "Profil aktif: $selected"
}

remove_cf_profile() {
  local selected yes
  read -r -p "ID profil yang dihapus: " selected
  [ -n "$selected" ] || return 0
  read -r -p "Hapus profil $selected? Domain tetap ada namun tidak bisa dikelola sampai dipindah. [y/N]: " yes
  [ "$yes" = y ] || return 0
  api_call DELETE "/api/admin/cloudflare/profiles/$selected" || return 0
  echo "Profil $selected dihapus dari database."
}

# Impor sekali jalan dari cloudflare-state.json lama. Idempoten: profil yang
# sudah ada tidak ditimpa, jadi aman dijalankan ulang.
import_state_file() {
  local payload result
  if [ ! -f "$STATE" ]; then
    echo "File $STATE tidak ada. Tidak ada yang diimpor."
    return 0
  fi
  payload=$(python3 - "$STATE" <<'PY'
import json, sys
print(json.dumps({"state": json.load(open(sys.argv[1]))}))
PY
) || { echo "File $STATE bukan JSON valid. Import dibatalkan."; return 0; }
  result=$(api_json POST /api/admin/cloudflare/import "$payload" 60) || return 0
  printf '%s' "$result" | python3 -c '
import json, sys
counts = json.load(sys.stdin).get("imported") or {}
print("Import selesai: {} profil, {} domain, tunnel={}, profil aktif={}".format(
    counts.get("profiles", 0), counts.get("domains", 0),
    "ya" if counts.get("tunnel") else "tidak", counts.get("active_profile") or "-"))
'
}

cf_profiles_menu() {
  local profiles
  while true; do
    echo
    echo "=== Akun Cloudflare ==="
    if profiles=$(api_json GET /api/admin/cloudflare/profiles); then
      printf '%s' "$profiles" | python3 -c '
import json, sys
items = json.load(sys.stdin)
if not items:
    print("Belum ada profil.")
for p in items:
    pid = p.get("id") or ""
    marker = "*" if p.get("active") else " "
    worker = " | worker deployed" if p.get("worker_deployed") else ""
    print(marker + " " + pid + ": " + (p.get("label") or pid) + " | Account ID: " + (p.get("account_id") or "") + worker)
'
    fi
    echo "1. Tambah/login akun Cloudflare"
    echo "2. Pilih akun aktif"
    echo "3. Hapus akun Cloudflare"
    echo "4. Import cloudflare-state.json ke database"
    echo "0. Kembali"
    read -r -p "Choose: " choice
    case "$choice" in
      1) add_cf_profile ;; 2) select_cf_profile ;; 3) remove_cf_profile ;;
      4) import_state_file ;; 0) return ;;
      *) echo "Pilihan salah." ;;
    esac
  done
}

add_domain() {
  local profile domain payload
  profile=$(choose_profile) || return 0
  read -r -p "Domain TempMail untuk profil $profile: " domain
  [ -n "$domain" ] || return 0
  payload=$(CF_DOMAIN="$domain" CF_PROFILE="$profile" tm_json domain CF_DOMAIN profile CF_PROFILE)
  api_call POST /api/admin/cloudflare/domains "$payload" 60 || return 0
  echo "Domain ditambahkan. Pilih aktifkan routing setelah Worker profile ini di-deploy."
}

list_domains() {
  local domains
  domains=$(api_json GET /api/admin/cloudflare/domains) || return 0
  printf '%s' "$domains" | python3 -c '
import json, sys
items = sorted(json.load(sys.stdin), key=lambda d: d.get("domain") or "")
if not items:
    print("Belum ada domain.")
for d in items:
    print("{} | profile={} | TempMail={} | Routing={}".format(
        d.get("domain"), d.get("profile"),
        "ON" if d.get("enabled") else "OFF",
        "ON" if d.get("routing") else "OFF"))
'
}

remove_domain() {
  local domain yes
  read -r -p "Domain yang dihapus dari TempMail: " domain
  [ -n "$domain" ] || return 0
  read -r -p "Hapus $domain dari TempMail lokal? DNS/Cloudflare tidak dihapus. [y/N]: " yes
  [ "$yes" = y ] || return 0
  api_call DELETE "/api/admin/cloudflare/domains/$domain" || return 0
  refresh_app_domains
}

domains_menu() {
  while true; do
    echo
    echo "=== Domain TempMail ==="
    list_domains
    echo "1. Tambah domain dari akun aktif"
    echo "2. Hapus domain dari TempMail"
    echo "3. Refresh domain ke service"
    echo "0. Kembali"
    read -r -p "Choose: " choice
    case "$choice" in
      1) add_domain ;; 2) remove_domain ;; 3) refresh_app_domains ;; 0) return ;;
      *) echo "Pilihan salah." ;;
    esac
  done
}

set_copy_destinations() {
  local current input payload
  current=$(state_get_copy 2>/dev/null) || current=""
  echo "Tujuan salinan sekarang: ${current:-OFF}"
  read -r -p "Email tujuan, pisahkan koma. Kosongkan untuk OFF: " input
  payload=$(TM_COPIES="$input" python3 -c '
import json, os
raw = os.environ.get("TM_COPIES", "")
print(json.dumps({"destinations": [part.strip() for part in raw.split(",") if part.strip()]}))
')
  api_call PUT /api/admin/cloudflare/copies "$payload" || return 0
  echo "Tersimpan. Deploy Worker profile terkait untuk menerapkan."
}

state_get_copy() {
  local copies
  copies=$(api_json GET /api/admin/cloudflare/copies) || return 1
  printf '%s' "$copies" | python3 -c '
import json, sys
print(", ".join(json.load(sys.stdin).get("destinations") or []))
'
}

logout_tunnel() {
  read -r -p "Hapus service + credential CF Tunnel di server ini? (y/N): " c
  [ "$c" = y ] || { echo "Batal."; return; }
  systemctl stop cloudflared 2>/dev/null || true
  systemctl disable cloudflared 2>/dev/null || true
  cloudflared service uninstall 2>/dev/null || true
  rm -rf /root/.cloudflared /etc/cloudflared
  echo "Service + credential CF Tunnel lokal dihapus."
  echo "cloudflared harus dipasang ulang dari panel admin (/admin -> Server) atau lewat menu 4 di menu ini."
}

reset_all() {
  echo "PERINGATAN: Ini akan menghapus SEMUA credential dan state Cloudflare."
  echo "Service TempMail tetap jalan, data email tidak terhapus."
  read -r -p "Ketik RESET untuk konfirmasi: " c
  [ "$c" = "RESET" ] || { echo "Batal."; return; }
  logout_tunnel
  rm -f "$STATE"
  echo '{}' > "$STATE"
  echo "Reset selesai. Profil/domain Cloudflare di panel dan database TIDAK dihapus (kelola dari menu 1/2 atau panel admin)."
  echo "Jalankan menu 8 untuk setup ulang."
}


# Setup tunnel lewat API token profil aktif. Tidak ada login browser: API membuat
# tunnel, token konektor disisipkan ke daftar perintah, lalu perintah itu dijalankan
# satu per satu sebagai root di sini.
tunnel_setup_api() {
  local default_name tunnel_name web_host input payload created id token tun
  local cmds_file cmd shown tunnel_state
  default_name=$(grep '^CF_TUNNEL_NAME=' "$APP_ENV" 2>/dev/null | cut -d= -f2- || true)
  [ -n "$default_name" ] || default_name=$TUNNEL_NAME
  # Web host diambil dari state file, lalu dari database lewat API tunnel.
  web_host=$(state_get tunnel web_host 2>/dev/null || true)
  if [ -z "$web_host" ]; then
    tun=$(api_json GET /api/admin/cloudflare/tunnel "" 15 2>/dev/null) || tun=""
    if [ -n "$tun" ]; then
      web_host=$(printf '%s' "$tun" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("web_host") or "")
' 2>/dev/null || true)
    fi
  fi
  echo "Tunnel Cloudflare dikelola lewat API token profil aktif (tanpa login browser)."
  read -r -p "Hostname web tunnel${web_host:+ [$web_host]}: " input || input=""
  if [ -n "$input" ]; then
    web_host=$input
  fi
  if [ -z "$web_host" ]; then
    echo "Hostname web tunnel wajib diisi."
    return 0
  fi
  read -r -p "Nama tunnel [$default_name]: " input || input=""
  tunnel_name=${input:-$default_name}
  payload=$(CF_NAME="$tunnel_name" CF_HOST="$web_host" tm_json name CF_NAME web_host CF_HOST)
  created=$(api_json POST /api/admin/cloudflare/tunnel/create "$payload" 60) || return 0
  cmds_file=$(mktemp)
  chmod 600 "$cmds_file"
  id=$(printf '%s' "$created" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("id") or "")
' 2>/dev/null || true)
  token=$(printf '%s' "$created" | python3 -c '
import json, sys
print(json.load(sys.stdin).get("token") or "")
' 2>/dev/null || true)
  printf '%s' "$created" | python3 -c '
import json, sys
cmds = json.load(sys.stdin).get("commands") or []
sys.stdout.write("\n".join(cmds))
' >"$cmds_file" 2>/dev/null || true
  if [ -z "$id" ]; then
    rm -f "$cmds_file"
    echo "API tidak mengembalikan ID tunnel. Cek panel admin (/admin -> Tunnel)."
    return 0
  fi
  # Token konektor tidak pernah dicetak: perintah dari API sudah memuatnya, jadi
  # yang ditampilkan hanya versi tersamarkan.
  if [ -s "$cmds_file" ]; then
    while IFS= read -r cmd || [ -n "$cmd" ]; do
      [ -n "$cmd" ] || continue
      shown=$cmd
      if [ -n "$token" ]; then
        shown=${cmd//"$token"/"***"}
      fi
      printf '  $ %s\n' "$shown"
      if ! run_root_command "$cmd"; then
        echo "  GAGAL: perintah di atas gagal, proses dihentikan."
        echo "  Install cloudflared bisa diulang dari panel admin (/admin -> Server) atau menu 4."
        rm -f "$cmds_file"
        return 0
      fi
    done <"$cmds_file"
  fi
  rm -f "$cmds_file"
  payload=$(CF_ID="$id" CF_NAME="$tunnel_name" CF_HOST="$web_host" \
    tm_json id CF_ID name CF_NAME web_host CF_HOST)
  api_call PUT /api/admin/cloudflare/tunnel "$payload" || return 0
  # State file tetap menyimpan key tunnel untuk jalur impor dan fallback dashboard.
  CF_TUNNEL_ID="$id" CF_TUNNEL_NAME="$tunnel_name" CF_WEB_HOST="$web_host" python3 - "$STATE" <<'PY'
import json, os, sys
path = sys.argv[1]
with open(path) as fh:
    data = json.load(fh)
data.setdefault("tunnel", {}).update({
    "id": os.environ["CF_TUNNEL_ID"],
    "name": os.environ["CF_TUNNEL_NAME"],
    "web_host": os.environ["CF_WEB_HOST"],
})
with open(path, "w") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
PY
  tunnel_state=$(systemctl is-active cloudflared 2>/dev/null || true)
  if [ "$tunnel_state" = "active" ]; then
    echo "Tunnel siap: https://$web_host/app/ (cloudflared active)"
  else
    echo "Tunnel tersimpan di database, tetapi service cloudflared: ${tunnel_state:-tidak terpasang}."
    echo "Ulangi menu 4, atau pasang dari panel admin (/admin -> Server)."
  fi
}

# Jalankan perintah dari API apa adanya; prefix "sudo " dibuang bila host tidak
# punya sudo (menu ini sudah jalan sebagai root).
run_root_command() {
  local cmd=$1
  if ! command -v sudo >/dev/null 2>&1; then
    cmd=${cmd#sudo }
  fi
  bash -c "$cmd"
}

deploy_worker() {
  local profile
  profile=$(choose_profile) || return 0
  api_call POST "/api/admin/cloudflare/profiles/$profile/deploy-worker" '{}' 180 || return 0
  echo "Worker profile $profile deployed ke Cloudflare (secret diisi otomatis oleh app)."
}

delete_worker() {
  local profile yes
  profile=$(choose_profile) || return 0
  read -r -p "Hapus worker tempmailbyjhopanstore dari Cloudflare? (y/N): " yes
  [ "$yes" = y ] || { echo "Batal."; return 0; }
  api_call DELETE "/api/admin/cloudflare/profiles/$profile/worker" 60 || return 0
  echo "Worker dihapus dari Cloudflare."
}

enable_routing_for_domain() {
  local domain
  read -r -p "Domain yang diaktifkan catch-all: " domain
  [ -n "$domain" ] || return 0
  # Error Cloudflare (mis. token kurang izin) diteruskan apa adanya oleh API di "detail".
  api_call POST "/api/admin/cloudflare/domains/$domain/routing" \
    '{"routing":true}' 60 || return 0
  refresh_app_domains
  echo "Routing aktif: *@$domain → Worker → TempMail"
}

dashboard() {
  local service rss inboxes messages backup tunnel
  local host port api_key admin_email
  local C_GREEN='\033[0;32m' C_RED='\033[0;31m' C_CYAN='\033[0;36m' C_YELLOW='\033[0;33m' C_BOLD='\033[1m' C_DIM='\033[2m' C_NC='\033[0m'
  service=$(systemctl is-active tempmail 2>/dev/null || true)
  rss=$(ps -o rss= -C tempmail 2>/dev/null | awk 'NR==1 {printf "%.1f MiB",$1/1024}')
  inboxes=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM inboxes;' 2>/dev/null || echo 0)
  messages=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM messages;' 2>/dev/null || echo 0)
  backup=$(systemctl is-active tempmail-backup.timer 2>/dev/null || true)
  tunnel=$(systemctl is-active cloudflared 2>/dev/null || true)
  port=$(app_port)
  host=$(hostname -I | awk '{print $1}')
  api_key=$(grep '^EMAIL_API_KEY=' "$APP_ENV" 2>/dev/null | cut -d= -f2)
  admin_email=$(sqlite3 "$APP/data/tempmail.db" 'SELECT email FROM users WHERE role="admin" LIMIT 1;' 2>/dev/null || echo "belum")

  # Status Cloudflare dari database lewat API. Kalau service mati, hanya field
  # tunnel yang dibaca dari state file lama dan ditandai jelas.
  local cf_source="api" cf_marker="" status_json parsed
  local dom_val="belum ada" tun_name="" tun_id="" web_url="" tun_status="" tun_conn=0
  local routing_on="OFF" copy="OFF"
  local prof_json prof_parsed prof_ok=0 prof_total=0 prof_token=0 active_prof="" prof_worker="✗ belum"
  if status_json=$(api_json GET /api/admin/cloudflare/status "" 15 2>/dev/null) && [ -n "$status_json" ]; then
    parsed=$(printf '%s' "$status_json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
domains = d.get("domains") or []
tunnel = d.get("tunnel") or {}
print("\t".join([
    ", ".join(x.get("domain") or "" for x in domains) or "belum ada",
    "ON" if any(x.get("routing") for x in domains) else "OFF",
    ", ".join(d.get("copies") or []) or "OFF",
    tunnel.get("web_host") or "",
    tunnel.get("name") or "",
    tunnel.get("id") or "",
    tunnel.get("status") or "",
    str(tunnel.get("connections") or 0),
]))
' 2>/dev/null) || parsed=""
    if [ -n "$parsed" ]; then
      IFS=$'\t' read -r dom_val routing_on copy web_url tun_name tun_id tun_status tun_conn <<<"$parsed"
      [ -n "$copy" ] || copy=OFF
      [ -n "$tun_status" ] || tun_status="unknown"
    else
      cf_source="state file"
    fi
  else
    cf_source="state file"
  fi
  # Profil + token dari endpoint profil, sumber data yang sama dengan panel admin.
  if prof_json=$(api_json GET /api/admin/cloudflare/profiles "" 15 2>/dev/null) && [ -n "$prof_json" ]; then
    prof_parsed=$(printf '%s' "$prof_json" | python3 -c '
import json, sys
items = json.load(sys.stdin)
active = next((p for p in items if p.get("active")), None)
print("\t".join([
    str(len(items)),
    str(sum(1 for p in items if p.get("has_token"))),
    (active.get("id") or "") if active else "",
    ("✓ deployed" if active.get("worker_deployed") else "✗ belum") if active else "✗ belum",
]))
' 2>/dev/null) || prof_parsed=""
    if [ -n "$prof_parsed" ]; then
      prof_ok=1
      IFS=$'\t' read -r prof_total prof_token active_prof prof_worker <<<"$prof_parsed"
    fi
  fi
  if [ "$cf_source" != "api" ]; then
    cf_marker=" (state file)"
    # Hanya field tunnel yang diambil dari state file; angka lain ditandai tidak terbaca.
    web_url=$(state_get tunnel web_host 2>/dev/null || true)
    tun_name=$(state_get tunnel name 2>/dev/null || true)
    tun_id=$(state_get tunnel id 2>/dev/null || true)
    tun_status=""
    tun_conn=0
    dom_val="tidak terbaca (API mati)"
    routing_on="-"
    copy="-"
  fi

  # ── Dashboard ──
  echo
  printf "  ${C_BOLD}╔══════════════════════════════════════════════╗${C_NC}\n"
  printf "  ${C_BOLD}║      TempMail By JhopanStore                 ║${C_NC}\n"
  printf "  ${C_BOLD}║        Credit JhopanStore                    ║${C_NC}\n"
  printf "  ${C_BOLD}╚══════════════════════════════════════════════╝${C_NC}\n"
  echo
  printf "  ${C_DIM}%-16s${C_NC} %s / %s\n" "Platform" "$(. /etc/os-release; echo "$PRETTY_NAME")" "$(uname -m)"
  if [ "${service:-inactive}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC} | %s\n" "Service" "${service:-inactive}" "${rss:-0 MiB}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC} | %s\n" "Service" "${service:-inactive}" "${rss:-0 MiB}"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Admin" "$admin_email"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Password" "(ditanya saat login, tidak disimpan)"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Domains" "$dom_val"
  printf "  ${C_DIM}%-16s${C_NC} ${C_CYAN}http://%s:%s/app/${C_NC}\n" "Web LAN" "$host" "$port"
  if [ -n "$web_url" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_CYAN}https://%s/app/${C_NC}\n" "Web Tunnel" "$web_url"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_DIM}belum di-setup${C_NC}\n" "Web Tunnel"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s inbox | %s message\n" "Inbox" "$inboxes" "$messages"
  if [ "${backup:-inactive}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "SQLite Backup" "${backup:-inactive}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "SQLite Backup" "${backup:-inactive}"
  fi
  printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "API Key" "$api_key"
  echo
  echo -e "  ${C_BOLD}─── Cloudflare (Tunnel) ───${C_NC}${C_YELLOW}${cf_marker}${C_NC}"
  if [ "$tun_status" = "healthy" ] || [ "$tun_status" = "degraded" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Konektor" "$tun_status ($tun_conn koneksi)"
  elif [ -n "$tun_status" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Konektor" "$tun_status"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_DIM}%s${C_NC}\n" "Konektor" "belum bisa dibaca"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Tunnel Name" "${tun_name:-belum dibuat}"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Tunnel ID" "${tun_id:-belum dibuat}"
  if [ "${tunnel:-not configured}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Tunnel Service" "${tunnel:-not configured}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Tunnel Service" "${tunnel:-not configured}"
  fi
  if [ "$routing_on" = "ON" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Email Routing" "$routing_on"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Email Routing" "$routing_on"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Salinan Email" "$copy"
  echo
  echo -e "  ${C_BOLD}─── Cloudflare API token ───${C_NC}"
  if [ "$prof_ok" = 1 ]; then
    printf "  ${C_DIM}%-16s${C_NC} %s\n" "Profil" "$prof_total profil"
    if [ "$prof_token" -gt 0 ]; then
      printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Punya Token" "$prof_token dari $prof_total profil"
    else
      printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Punya Token" "0 dari $prof_total profil, tempel token di /admin -> Akun Cloudflare"
    fi
    printf "  ${C_DIM}%-16s${C_NC} %s\n" "Profil Aktif" "${active_prof:-belum ada}"
    printf "  ${C_DIM}%-16s${C_NC} %s\n" "Worker" "$prof_worker"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_DIM}%s${C_NC}\n" "Status" "profil tidak bisa dibaca dari API (systemctl status tempmail)"
  fi
  echo
}

