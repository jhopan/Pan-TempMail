# panel_url: alamat panel admin dari web host tunnel, atau alamat lokal sebagai cadangan.
panel_url() {
  local host
  host=$(api_json GET /api/admin/cloudflare/tunnel 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    data = {}
print((data.get("web_host") or "").strip())
' 2>/dev/null)
  if [ -n "$host" ]; then
    printf 'https://%s/admin' "$host"
  else
    printf 'http://127.0.0.1:%s/admin' "$(app_port)"
  fi
}

# set_profile_token: tempel atau ganti API token satu profil. Pemasangan awal lewat
# login wrangler hanya menghasilkan profil tanpa token, dan tanpa token panel admin
# tidak bisa membaca zone, Worker, tunnel, maupun Email Routing.
set_profile_token() {
  local selected profiles token payload url
  url=$(panel_url)
  profiles=$(api_json GET /api/admin/cloudflare/profiles) || return 0
  printf '%s' "$profiles" | python3 -c '
import json, sys
items = json.load(sys.stdin)
if not items:
    print("(belum ada profil)")
for p in items:
    pid = p.get("id") or ""
    mark = "aktif" if p.get("active") else "     "
    token = "token ada" if p.get("has_token") else "token KOSONG"
    print("%-14s %s  %s  %s" % (pid, mark, token, p.get("label") or ""))
'
  read -r -p "ID profil yang diisi tokennya (kosong = profil aktif): " selected
  [ -n "$selected" ] || selected=$(choose_profile) || return 0
  echo "Buat token di https://dash.cloudflare.com/profile/api-tokens dengan izin wajib:"
  echo "  Zone:Read, Zone Settings:Edit, DNS:Edit, Email Routing Rules:Edit, Workers Scripts:Edit"
  echo "  Opsional: Cloudflare Tunnel:Edit (kelola tunnel), Account Settings:Read."
  read -r -s -p "Tempel Cloudflare API token: " token; echo
  [ -n "$token" ] || { echo "Token kosong, dibatalkan."; return 0; }
  payload=$(CF_TOKEN="$token" tm_json token CF_TOKEN)
  unset token
  api_call PUT "/api/admin/cloudflare/profiles/$selected" "$payload" 60 || return 0
  unset payload
  refresh_app_domains
  echo "Token profil $selected tersimpan (terenkripsi di database, tidak ditampilkan lagi)."
  echo "Buka $url -> Periksa semua, lalu Rapikan pada domain yang belum siap."
}

doctor() {
  local C_GREEN='\033[0;32m' C_RED='\033[0;31m' C_CYAN='\033[0;36m' C_YELLOW='\033[0;33m' C_BOLD='\033[1m' C_DIM='\033[2m' C_NC='\033[0m'
  local pass=0 fail=0
  local port app_env api_key tun_id="" web_url="" tun_status="" tun_conn=0
  local cf_ok=0 cf_active="" cf_profiles=0 cf_domains=0 cf_routing="OFF" cf_worker="no"
  local prof_json="" prof_parsed="" prof_ok=0 prof_total=0 prof_token=0 prof_active="" prof_has_token="no"
  app_env="$APP_ENV"
  port=$(app_port)
  api_key=$(grep '^EMAIL_API_KEY=' "$app_env" 2>/dev/null | cut -d= -f2)

  echo
  echo -e "  ${C_BOLD}═══ TempMail Doctor - Health Check ═══${C_NC}"
  echo

  # 1. Binary exists
  if [ -f "$APP/tempmail" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Binary            : $APP/tempmail"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Binary            : TIDAK ADA di $APP/tempmail"
    fail=$((fail+1))
  fi

  # 2. Service active
  if systemctl is-active --quiet tempmail; then
    echo -e "  ${C_GREEN}✓${C_NC} Service           : active"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Service           : inactive - jalankan: systemctl start tempmail"
    fail=$((fail+1))
  fi

  # 3. Config file
  if [ -f "$app_env" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Config            : $app_env"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Config            : TIDAK ADA - $app_env"
    fail=$((fail+1))
  fi

  # 4. JWT_SECRET set
  if grep -q '^JWT_SECRET=.' "$app_env" 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_NC} JWT_SECRET        : set"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} JWT_SECRET        : kosong - generate: openssl rand -hex 32"
    fail=$((fail+1))
  fi

  # 5. EMAIL_API_KEY set
  if grep -q '^EMAIL_API_KEY=.' "$app_env" 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_NC} EMAIL_API_KEY     : set"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} EMAIL_API_KEY     : kosong - generate: openssl rand -hex 32"
    fail=$((fail+1))
  fi

  # 6. DOMAINS set
  if grep -q '^DOMAINS=.' "$app_env" 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_NC} DOMAINS           : $(grep '^DOMAINS=' "$app_env" | cut -d= -f2)"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} DOMAINS           : kosong"
    fail=$((fail+1))
  fi

  # 7. Database
  if [ -f "$APP/data/tempmail.db" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Database          : $APP/data/tempmail.db"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Database          : TIDAK ADA - akan dibuat saat start"
    fail=$((fail+1))
  fi

  # 8. Local health check
  local health
  health=$(curl -s --max-time 5 "http://127.0.0.1:$port/health" 2>/dev/null || true)
  if echo "$health" | grep -q '"ok"'; then
    echo -e "  ${C_GREEN}✓${C_NC} Local health      : OK (port $port)"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Local health      : TIDAK MERESPON di port $port"
    fail=$((fail+1))
  fi

  # 9. Admin user exists
  local user_count
  user_count=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM users WHERE role="admin";' 2>/dev/null || echo "0")
  if [ "$user_count" -gt 0 ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Admin user        : $user_count admin"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Admin user        : belum ada - jalankan: curl -X POST http://127.0.0.1:$port/api/setup ..."
    fail=$((fail+1))
  fi

  # Status Cloudflare dari database lewat API, bukan dari state file.
  local cf_status parsed
  if cf_status=$(api_json GET /api/admin/cloudflare/status "" 15 2>/dev/null) && [ -n "$cf_status" ]; then
    parsed=$(printf '%s' "$cf_status" | python3 -c '
import json, sys
d = json.load(sys.stdin)
profiles = d.get("profiles") or []
domains = d.get("domains") or []
active = d.get("active_profile") or ""
worker = "no"
for p in profiles:
    if p.get("id") == active and p.get("worker_deployed"):
        worker = "yes"
tunnel = d.get("tunnel") or {}
print("\t".join([
    active, str(len(profiles)), str(len(domains)),
    "ON" if any(x.get("routing") for x in domains) else "OFF",
    worker, tunnel.get("id") or "", tunnel.get("web_host") or "",
    tunnel.get("status") or "", str(tunnel.get("connections") or 0),
]))
' 2>/dev/null) || parsed=""
    if [ -n "$parsed" ]; then
      cf_ok=1
      IFS=$'\t' read -r cf_active cf_profiles cf_domains cf_routing cf_worker tun_id web_url tun_status tun_conn <<<"$parsed"
    fi
  fi

  # Profil + token dari endpoint profil: dipakai cek API token (nomor 17).
  if prof_json=$(api_json GET /api/admin/cloudflare/profiles "" 15 2>/dev/null) && [ -n "$prof_json" ]; then
    prof_parsed=$(printf '%s' "$prof_json" | python3 -c '
import json, sys
items = json.load(sys.stdin)
active = next((p for p in items if p.get("active")), None)
print("\t".join([
    str(len(items)),
    str(sum(1 for p in items if p.get("has_token"))),
    (active.get("id") or "") if active else "",
    "yes" if (active and active.get("has_token")) else "no",
]))
' 2>/dev/null) || prof_parsed=""
    if [ -n "$prof_parsed" ]; then
      prof_ok=1
      IFS=$'\t' read -r prof_total prof_token prof_active prof_has_token <<<"$prof_parsed"
    fi
  fi

  echo
  echo -e "  ${C_BOLD}─── Cloudflare ───${C_NC}"

  # 10. Admin API + status Cloudflare
  if [ "$cf_ok" = 1 ]; then
    echo -e "  ${C_GREEN}✓${C_NC} CF API status     : OK ($(api_base)/api/admin/cloudflare/status)"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} CF API status     : TIDAK MENJAWAB di $(api_base)/api/admin/cloudflare/status"
    echo -e "  ${C_DIM}                      cek: systemctl status tempmail, lalu ADMIN_EMAIL/ADMIN_PASS di $app_env${C_NC}"
    fail=$((fail+1))
  fi

  # 11. Konektor tunnel (status dari API Cloudflare)
  if [ "$cf_ok" = 1 ] && { [ "$tun_status" = "healthy" ] || [ "$tun_status" = "degraded" ]; }; then
    echo -e "  ${C_GREEN}✓${C_NC} Tunnel konektor   : $tun_status ($tun_conn koneksi)"
    pass=$((pass+1))
  elif [ "$cf_ok" = 1 ]; then
    echo -e "  ${C_RED}✗${C_NC} Tunnel konektor   : ${tun_status:-belum ada} - menutempmail -> 4"
    fail=$((fail+1))
  fi

  # 11. cloudflared service
  if systemctl is-active --quiet cloudflared 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_NC} cloudflared svc   : active"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} cloudflared svc   : inactive - systemctl start cloudflared"
    fail=$((fail+1))
  fi

  # 12. Tunnel config
  if [ -f /etc/cloudflared/config.yml ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Tunnel config     : /etc/cloudflared/config.yml"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Tunnel config     : TIDAK ADA"
    fail=$((fail+1))
  fi

  # 14. Tunnel ID dari database (status API)
  if [ -n "$tun_id" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Tunnel ID         : $tun_id"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Tunnel ID         : belum tersimpan di database"
    fail=$((fail+1))
  fi

  # 15. Profil Cloudflare di database
  if [ "$cf_profiles" -gt 0 ]; then
    echo -e "  ${C_GREEN}✓${C_NC} CF profiles       : $cf_profiles profil (aktif: ${cf_active:-belum})"
    pass=$((pass+1))
  elif [ "$cf_ok" = 1 ]; then
    echo -e "  ${C_RED}✗${C_NC} CF profiles       : kosong - menutempmail → 1 (atau opsi 4 impor)"
    fail=$((fail+1))
  fi

  # 16. Domain TempMail di database
  if [ "$cf_domains" -gt 0 ]; then
    echo -e "  ${C_GREEN}✓${C_NC} CF domains        : $cf_domains domain"
    pass=$((pass+1))
  elif [ "$cf_ok" = 1 ]; then
    echo -e "  ${C_RED}✗${C_NC} CF domains        : kosong - menutempmail → 2"
    fail=$((fail+1))
  fi

  echo
  echo -e "  ${C_BOLD}─── Worker + API token ───${C_NC}"

  # 17. API token profil aktif
  if [ "$prof_ok" = 1 ] && [ "$prof_has_token" = "yes" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} API token profil  : ${prof_active} punya token"
    pass=$((pass+1))
  elif [ "$prof_ok" = 1 ] && [ -z "$prof_active" ]; then
    echo -e "  ${C_RED}✗${C_NC} API token profil  : belum ada profil aktif - menutempmail -> 1"
    fail=$((fail+1))
  elif [ "$prof_ok" = 1 ]; then
    echo -e "  ${C_RED}✗${C_NC} API token profil  : ${prof_active} belum punya token ($prof_token dari $prof_total profil punya token)"
    echo -e "  ${C_DIM}                      tempel (paste) API token Cloudflare untuk profil itu di /admin -> Akun Cloudflare${C_NC}"
    fail=$((fail+1))
  else
    echo -e "  ${C_RED}✗${C_NC} API token profil  : tidak bisa dibaca - systemctl status tempmail"
    fail=$((fail+1))
  fi

  # 18. Worker deployed (status dari database via API)
  if [ "$cf_worker" = "yes" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Worker            : deployed"
    pass=$((pass+1))
  elif [ "$cf_ok" = 1 ]; then
    echo -e "  ${C_RED}✗${C_NC} Worker            : belum - menutempmail -> 5"
    fail=$((fail+1))
  fi

  # 19. Spool helper root (aksi Server di panel admin menulis ke sini)
  if [ -d "$HELPER_IN" ] && [ -w "$HELPER_IN" ]; then
    echo -e "  ${C_GREEN}✓${C_NC} Helper spool      : $HELPER_IN (writable)"
    pass=$((pass+1))
  else
    echo -e "  ${C_RED}✗${C_NC} Helper spool      : $HELPER_IN tidak ada / tidak writable"
    echo -e "  ${C_DIM}                      install.sh membuat dir ini; tanpa itu aksi Server di panel gagal.${C_NC}"
    fail=$((fail+1))
  fi

  echo
  echo -e "  ${C_BOLD}─── Tunnel Connectivity ───${C_NC}"

  # 20. Tunnel health (remote), web host dari database via API
  if [ -n "$web_url" ]; then
    local remote_health
    remote_health=$(curl -s --max-time 10 "https://$web_url/health" 2>/dev/null || true)
    if echo "$remote_health" | grep -q '"ok"'; then
      echo -e "  ${C_GREEN}✓${C_NC} Tunnel health     : OK (https://$web_url)"
      pass=$((pass+1))
    else
      echo -e "  ${C_RED}✗${C_NC} Tunnel health     : GAGAL - cek cloudflared + config.yml"
      fail=$((fail+1))
    fi
  else
    echo -e "  ${C_RED}✗${C_NC} Tunnel health     : web_host belum diset"
    fail=$((fail+1))
  fi

  # 21. API test via tunnel
  if [ -n "$web_url" ] && [ -n "$api_key" ]; then
    local api_test
    api_test=$(curl -s --max-time 10 "https://$web_url/api/config" 2>/dev/null || true)
    if echo "$api_test" | grep -q "domains"; then
      echo -e "  ${C_GREEN}✓${C_NC} API via tunnel    : OK"
      pass=$((pass+1))
    else
      echo -e "  ${C_RED}✗${C_NC} API via tunnel    : GAGAL"
      fail=$((fail+1))
    fi
  fi

  # 22. Email Routing status (dari database via API)
  if [ "$cf_ok" = 1 ]; then
    if [ "$cf_routing" = "ON" ]; then
      echo -e "  ${C_GREEN}✓${C_NC} Email Routing     : ON"
      pass=$((pass+1))
    else
      echo -e "  ${C_RED}✗${C_NC} Email Routing     : OFF - menutempmail → 6"
      fail=$((fail+1))
    fi
  fi

  echo
  echo -e "  ${C_BOLD}─── Backup ───${C_NC}"

  # 23. SQLite backup timer
  if systemctl is-active --quiet tempmail-backup.timer 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_NC} Backup timer      : active"
    pass=$((pass+1))
  else
    echo -e "  ${C_YELLOW}⚠${C_NC} Backup timer      : inactive - systemctl enable --now tempmail-backup.timer"
    fail=$((fail+1))
  fi

  # Summary
  echo
  echo -e "  ${C_BOLD}═══ Summary ═══${C_NC}"
  local total=$((pass+fail))
  if [ $fail -eq 0 ]; then
    echo -e "  ${C_GREEN}${C_BOLD}✓ ALL CHECKS PASSED ($pass/$total)${C_NC}"
    echo -e "  ${C_GREEN}TempMail By JhopanStore - sehat sempurna!${C_NC}"
  else
    echo -e "  ${C_GREEN}✓ Passed: $pass${C_NC}  ${C_RED}✗ Failed: $fail${C_NC}  ${C_DIM}(total: $total)${C_NC}"
    echo -e "  ${C_YELLOW}Perbaiki yang ✗ di atas.${C_NC}"
  fi
  echo
  read -r -p "  Tekan ENTER untuk kembali..."
}

manage_admin() {
  local app_env=/etc/tempmail/tempmail.env
  local port
  port=$(grep '^PORT=' "$app_env" | cut -d= -f2); port=${port:-8080}
  local base="http://127.0.0.1:$port"
  local C_GREEN='\033[0;32m' C_RED='\033[0;31m' C_CYAN='\033[0;36m' C_BOLD='\033[1m' C_NC='\033[0m'

  while true; do
    echo
    echo -e "  ${C_BOLD}=== Kelola Admin ===${C_NC}"
    echo '  1. Buat admin baru (hanya jika belum ada)'
    echo '  2. Lihat email admin'
    echo '  3. Reset password admin'
    echo '  0. Kembali'
    read -r -p '  Choose: ' c
    case "$c" in
      1)
        read -r -p "  Email admin: " ad_email
        read -r -s -p "  Password (min 6, tidak ditampilkan): " ad_pass
        echo
        curl -s -X POST "$base/api/setup" \
          -H "Content-Type: application/json" \
          -d "{\"email\":\"$ad_email\",\"password\":\"$ad_pass\"}" \
          | python3 -c "import sys,json
try:
    d=json.load(sys.stdin)
    if 'error' in d: print('  ❌',d['error'])
    else:
        print('  ✅ Admin dibuat:',d.get('user',{}).get('email',''))
except: print('  Error: response tidak valid')"
        # Hanya email yang disimpan; password admin tidak lagi ditulis plaintext.
        if grep -q '^ADMIN_EMAIL=' "$app_env" 2>/dev/null; then
          sed -i "s|^ADMIN_EMAIL=.*|ADMIN_EMAIL=$ad_email|" "$app_env"
        else
          echo "ADMIN_EMAIL=$ad_email" >> "$app_env"
        fi
        drop_admin_pass "$app_env"
        ;;
      2)
        echo
        local em
        em=$(sqlite3 /opt/tempmail/data/tempmail.db 'SELECT email FROM users WHERE role="admin" LIMIT 1;' 2>/dev/null || echo "belum ada")
        echo -e "  ${C_DIM}Email${C_NC}    : ${C_GREEN}$em${C_NC}"
        if grep -q '^ADMIN_PASS=' "$app_env" 2>/dev/null; then
          echo -e "  ${C_DIM}Password${C_NC}: ${C_YELLOW}masih tersimpan plaintext di $app_env (jalankan opsi 3 untuk menghapusnya)${C_NC}"
        else
          echo -e "  ${C_DIM}Password${C_NC}: ${C_GREEN}tidak disimpan, ditanya saat login${C_NC}"
        fi
        echo
        ;;
      3)
        echo
        read -r -p "  Email admin: " ad_email
        read -r -s -p "  Password baru (min 6, tidak ditampilkan): " ad_pass
        echo
        python3 -c "
import bcrypt, sqlite3
db = sqlite3.connect('/opt/tempmail/data/tempmail.db')
hashed = bcrypt.hashpw('$ad_pass'.encode(), bcrypt.gensalt()).decode()
try:
    db.execute('UPDATE users SET password_hash=? WHERE email=?', (hashed, '$ad_email'))
    db.commit()
    print('  ✅ Password diupdate untuk', '$ad_email')
except Exception as e:
    print('  ❌ Gagal:', e)
finally:
    db.close()
" 2>/dev/null || echo "  ❌ Butuh: pip install bcrypt"
        if grep -q '^ADMIN_EMAIL=' "$app_env" 2>/dev/null; then
          sed -i "s|^ADMIN_EMAIL=.*|ADMIN_EMAIL=$ad_email|" "$app_env"
        else
          echo "ADMIN_EMAIL=$ad_email" >> "$app_env"
        fi
        drop_admin_pass "$app_env"
        chmod 640 "$app_env" 2>/dev/null || true
        echo -e "  ${C_DIM}Password tidak disimpan ke file; menu akan menanyakan saat login.${C_NC}"
        ;;
      0|*) break ;;
    esac
  done
}

