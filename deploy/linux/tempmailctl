guided_setup() {
  local script="/opt/tempmail/setup.sh"
  [ -f "$script" ] || script="/root/tempmail-setup/setup.sh"
  bash "$script"
}

manage_admin() {
  local app_env=/etc/tempmail/tempmail.env
  local port
  port=$(grep '^PORT=' "$app_env" | cut -d= -f2); port=${port:-8080}
  local base="http://127.0.0.1:$port"
  local C_GREEN='\033[0;32m' C_CYAN='\033[0;36m' C_BOLD='\033[1m' C_NC='\033[0m'

  while true; do
    echo
    echo -e "  ${C_BOLD}=== Kelola Admin ===${C_NC}"
    echo '  1. Buat admin baru (hanya jika belum ada)'
    echo '  2. Cek user admin'
    echo '  3. Reset password admin'
    echo '  0. Kembali'
    read -r -p '  Choose: ' c
    case "$c" in
      1)
        read -r -p "  Email admin: " ad_email
        read -r -p "  Password (min 6): " ad_pass
        echo
        curl -s -X POST "$base/api/setup" \
          -H "Content-Type: application/json" \
          -d "{\"email\":\"$ad_email\",\"password\":\"$ad_pass\"}" \
          | python3 -c "import sys,json
try:
    d=json.load(sys.stdin)
    if 'error' in d: print('❌',d['error'])
    else: print('✅ Admin dibuat:',d.get('user',{}).get('email',''))
except: print('Error: response tidak valid')"
        ;;
      2)
        echo
        curl -s "$base/api/auth/login" -X POST \
          -H "Content-Type: application/json" \
          -d '{"email":"check","password":"check"}' 2>/dev/null | \
          python3 -c "import sys,json
try:
    d=json.load(sys.stdin)
    if 'error' in d: print('Login ditolak (expected):',d['error'])
    else: print('OK')
except: print('Server merespon')" 2>/dev/null || echo "Server tidak merespons"
        echo "Cek DB langsung:"
        sqlite3 /opt/tempmail/data/tempmail.db "SELECT id,email,role FROM users;" 2>/dev/null || echo "Tidak bisa akses DB"
        ;;
      3)
        echo
        echo "⚠️  Reset password akan update user di database langsung."
        read -r -p "  Email admin: " ad_email
        read -r -p "  Password baru (min 6): " ad_pass
        python3 -c "
import bcrypt, sqlite3
db = sqlite3.connect('/opt/tempmail/data/tempmail.db')
hashed = bcrypt.hashpw('$ad_pass'.encode(), bcrypt.gensalt()).decode()
try:
    db.execute('UPDATE users SET password_hash=? WHERE email=?', (hashed, '$ad_email'))
    db.commit()
    print('✅ Password diupdate untuk', '$ad_email')
except Exception as e:
    print('❌ Gagal:', e)
finally:
    db.close()
" 2>/dev/null || echo "❌ Butuh: pip install bcrypt"
        ;;
      0|*) break ;;
    esac
  done
}

