#!/usr/bin/env bash
# TempMail By JhopanStore control panel. Run: menutempmail
set -euo pipefail

APP=/opt/tempmail
ENV_DIR=/etc/tempmail
APP_ENV=$ENV_DIR/tempmail.env
STATE=$ENV_DIR/cloudflare-state.json
WORKER_DIR=$APP/worker
TUNNEL_NAME=tempmailbyjhopanstore

need_root() {
  [ "$(id -u)" = 0 ] || { echo "Run: menutempmail"; exit 1; }
}

app_port() {
  local p
  p=$(grep '^PORT=' "$APP_ENV" 2>/dev/null | cut -d= -f2)
  echo "${p:-8080}"
}

ensure_state() {
  install -d -o root -g root -m 0700 "$ENV_DIR"
  if [ ! -f "$STATE" ]; then
    printf '{"active_profile":"","profiles":{},"domains":{},"tunnel":{"id":"","account":"","web_hosts":[]}}\n' >"$STATE"
    chmod 600 "$STATE"
  fi
}

state_get() {
  python3 - "$STATE" "$@" <<'PY'
import json, sys
state, path = sys.argv[1], sys.argv[2:]
data = json.load(open(state))
for key in path:
    data = data.get(key, '') if isinstance(data, dict) else ''
print(data if not isinstance(data, (dict, list)) else json.dumps(data))
PY
}

refresh_app_domains() {
  local domains
  domains=$(python3 - "$STATE" <<'PY'
import json, sys
state=json.load(open(sys.argv[1]))
print(','.join(sorted(name for name, item in state['domains'].items() if item.get('enabled'))))
PY
)
  [ -n "$domains" ] || domains=local.invalid
  set_app_env DOMAINS "$domains"
  systemctl restart tempmail
}

set_app_env() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp)
  grep -v "^${key}=" "$APP_ENV" >"$tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  install -o root -g tempmail -m 0640 "$tmp" "$APP_ENV"
  rm -f "$tmp"
}

profile_token() {
  local profile=$1
  python3 - "$STATE" "$profile" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))['profiles'][sys.argv[2]]['token'])
PY
}

profile_account_id() {
  local profile=$1
  python3 - "$STATE" "$profile" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))['profiles'][sys.argv[2]].get('account_id',''))
PY
}

active_profile() {
  state_get active_profile
}

choose_profile() {
  local profile
  profile=$(active_profile)
  if [ -z "$profile" ]; then
    echo "Belum ada akun Cloudflare. Tambahkan dari menu akun." >&2
    return 1
  fi
  printf '%s' "$profile"
}

cf_api() {
  local profile=$1 method=$2 path=$3 body=${4:-}
  local token response
  token=$(profile_token "$profile")
  if [ -n "$body" ]; then
    response=$(curl -fsS -X "$method" "https://api.cloudflare.com/client/v4$path" \
      -H "Authorization: Bearer $token" -H 'Content-Type: application/json' --data "$body")
  else
    response=$(curl -fsS -X "$method" "https://api.cloudflare.com/client/v4$path" \
      -H "Authorization: Bearer $token")
  fi
  printf '%s' "$response" | python3 -c 'import json,sys; d=json.load(sys.stdin); (print(json.dumps(d.get("result"))) if d.get("success") else (_ for _ in ()).throw(SystemExit(json.dumps(d.get("errors",d))))'
}

zone_id() {
  local profile=$1 domain=$2 result
  result=$(cf_api "$profile" GET "/zones?name=$domain")
  printf '%s' "$result" | python3 - "$domain" <<'PY'
import json, sys
items=json.load(sys.stdin)
domain=sys.argv[1]
if not items or items[0].get('status') != 'active':
    raise SystemExit('Zone tidak ditemukan atau belum Active: ' + domain)
print(items[0]['id'])
PY
}

ensure_worker_tools() {
  if ! command -v npm >/dev/null 2>&1; then
    echo "Install Node.js/npm untuk Wrangler..."
    apt-get update -qq
    apt-get install -y -qq nodejs npm
  fi
}

add_cf_profile() {
  local name account token label
  read -r -p "ID profil (contoh: cf-a, cf-b): " name
  [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "ID hanya huruf/angka/-/_"; return; }
  read -r -p "Label akun (contoh: Cloudflare A): " label
  read -r -p "Cloudflare Account ID: " account
  read -r -s -p "Cloudflare API Token (disimpan root-only): " token; echo
  [ -n "$name" ] && [ -n "$account" ] && [ -n "$token" ] || { echo "Data wajib diisi."; return; }

  CF_NAME="$name" CF_LABEL="$label" CF_ACCOUNT="$account" CF_TOKEN="$token" python3 - "$STATE" <<'PY'
import json, os, sys
path=sys.argv[1]
data=json.load(open(path))
data['profiles'][os.environ['CF_NAME']]={
  'label': os.environ['CF_LABEL'] or os.environ['CF_NAME'],
  'account_id': os.environ['CF_ACCOUNT'],
  'token': os.environ['CF_TOKEN'],
  'worker_deployed': False,
}
if not data['active_profile']:
  data['active_profile']=os.environ['CF_NAME']
open(path,'w').write(json.dumps(data,indent=2)+'\n')
PY
  chmod 600 "$STATE"
  echo "Profil $name tersimpan. Token tidak ditampilkan dashboard."
}

select_cf_profile() {
  local selected
  python3 - "$STATE" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
for key,item in d['profiles'].items(): print(f'{key}\t{item.get("label",key)}')
PY
  read -r -p "Pilih ID profil: " selected
  python3 - "$STATE" "$selected" <<'PY'
import json,sys
path,key=sys.argv[1:]
d=json.load(open(path))
if key not in d['profiles']: raise SystemExit('Profil tidak ada.')
d['active_profile']=key
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  echo "Profil aktif: $selected"
}

remove_cf_profile() {
  local selected
  read -r -p "ID profil yang dihapus: " selected
  read -r -p "Hapus profil $selected? Domain tetap ada namun tidak bisa dikelola sampai dipindah. [y/N]: " yes
  [ "$yes" = y ] || return
  python3 - "$STATE" "$selected" <<'PY'
import json,sys
path,key=sys.argv[1:]
d=json.load(open(path))
if any(v.get('profile') == key for v in d['domains'].values()):
  raise SystemExit('Masih ada domain memakai profil ini. Hapus/pindahkan domain dulu.')
d['profiles'].pop(key, None)
if d['active_profile'] == key: d['active_profile']=''
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
}

cf_profiles_menu() {
  while true; do
    echo
    echo "=== Akun Cloudflare ==="
    python3 - "$STATE" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); active=d.get('active_profile','')
if not d['profiles']: print('Belum ada profil.')
for key,item in d['profiles'].items():
  marker='*' if key==active else ' '
  print(f'{marker} {key}: {item.get("label",key)} | Account ID: {item.get("account_id","")}')
PY
    echo "1. Tambah/login akun Cloudflare"
    echo "2. Pilih akun aktif"
    echo "3. Hapus akun Cloudflare"
    echo "0. Kembali"
    read -r -p "Choose: " choice
    case "$choice" in
      1) add_cf_profile ;; 2) select_cf_profile ;; 3) remove_cf_profile ;; 0) return ;;
      *) echo "Pilihan salah." ;;
    esac
  done
}

add_domain() {
  local profile domain zid
  profile=$(choose_profile) || return
  read -r -p "Domain TempMail untuk profil $profile: " domain
  [ -n "$domain" ] || return
  zid=$(zone_id "$profile" "$domain") || return
  CF_DOMAIN="$domain" CF_PROFILE="$profile" CF_ZONE="$zid" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path))
d['domains'][os.environ['CF_DOMAIN']]={'profile':os.environ['CF_PROFILE'],'zone_id':os.environ['CF_ZONE'],'enabled':False,'routing':False}
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  echo "Domain ditambahkan. Pilih aktifkan routing setelah Worker profile ini di-deploy."
}

list_domains() {
  python3 - "$STATE" <<'PY'
import json,sys
d=json.load(open(sys.argv[1]))
if not d['domains']: print('Belum ada domain.')
for name,item in sorted(d['domains'].items()):
  print(f"{name} | profile={item.get('profile')} | TempMail={'ON' if item.get('enabled') else 'OFF'} | Routing={'ON' if item.get('routing') else 'OFF'}")
PY
}

remove_domain() {
  local domain
  read -r -p "Domain yang dihapus dari TempMail: " domain
  read -r -p "Hapus $domain dari TempMail lokal? DNS/Cloudflare tidak dihapus. [y/N]: " yes
  [ "$yes" = y ] || return
  CF_DOMAIN="$domain" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['domains'].pop(os.environ['CF_DOMAIN'],None)
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  refresh_app_domains
}

domains_menu() {
  while true; do
    echo
    echo "=== Domain TempMail ==="
    list_domains
    echo "1. Tambah domain dari akun aktif"
    echo "2. Hapus domain dari TempMail"
    echo "3. Refresh domain ke service"
    echo "0. Kembali"
    read -r -p "Choose: " choice
    case "$choice" in
      1) add_domain ;; 2) remove_domain ;; 3) refresh_app_domains ;; 0) return ;;
      *) echo "Pilihan salah." ;;
    esac
  done
}

set_copy_destinations() {
  local current input
  current=$(state_get_copy)
  echo "Tujuan salinan sekarang: ${current:-OFF}"
  read -r -p "Email tujuan, pisahkan koma. Kosongkan untuk OFF: " input
  CF_COPIES="$input" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['copy_destinations']=os.environ['CF_COPIES']
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  echo "Tersimpan. Deploy Worker profile terkait untuk menerapkan."
}

state_get_copy() {
  python3 - "$STATE" <<'PY'
import json,sys
print(json.load(open(sys.argv[1])).get('copy_destinations',''))
PY
}

# Login headless dengan fallback paste-link (sama seperti setup.sh):
# proses login jalan di background, user buka link di browser PC, klik Allow,
# browser gagal load (ERR_CONNECTION_REFUSED) -> copy URL address bar -> paste di sini.
run_login() {
  # Headless OAuth via --device flag (RFC 8628): user cukup buka URL + masukkan kode.
  # Tidak pakai localhost callback sama sekali - cocok untuk SSH/headless.
  local label=$1; shift
  local logf url code pid

  logf=$(mktemp)
  "$@" >"$logf" 2>&1 &
  pid=$!

  # Tunggu URL + kode device flow muncul (max 15s)
  url=""; code=""
  for _ in $(seq 1 15); do
    url=$(grep -oE 'https://dash\.cloudflare\.com/oauth2/device/verify[^ "]*' "$logf" | head -1 || true)
    code=$(grep -oE 'and enter the code:' "$logf" | head -1 || true)
    [ -n "$url" ] && break
    sleep 1
  done

  # Fallback: URL biasa (bukan device flow)
  if [ -z "$url" ]; then
    url=$(grep -oE 'https://dash\.cloudflare\.com/[^ "]+' "$logf" | head -1 || true)
  fi

  if [ -z "$url" ]; then
    echo "URL login tidak muncul. Output:"
    cat "$logf"
    wait "$pid" 2>/dev/null || true
    rm -f "$logf"
    return 1
  fi

  echo
  echo "===== LOGIN $label ====="
  echo "Buka URL ini di browser (HP/laptop manapun):"
  echo
  echo "  $url"
  echo
  # Tampilkan kode dari output wrangler
  device_code=$(grep -A2 'enter the code' "$logf" | grep -oE '[A-Za-z0-9]{8}' | head -1 || true)
  if [ -n "$device_code" ]; then
    echo "Masukkan kode ini di halaman browser:"
    echo
    echo "  $device_code"
    echo
  fi
  echo "Klik Continue / Authorize di browser."
  echo "Setelah selesai, TEKAN ENTER di sini."
  echo
  read -r -p "Sudah authorize? Tekan ENTER untuk lanjut..." _

  wait "$pid" 2>/dev/null || true
  rm -f "$logf"
  return 0
}

wrangler_logged_in() {
  # Cek cepat: file token lokal ada? (instan, tanpa API call)
  if [ -f /root/.wrangler/config/default.toml ] || [ -f /root/.config/.wrangler/config/default.toml ]; then
    return 0
  fi
  # Fallback: tanya API (max 20s). whoami always exits 0; must grep output.
  timeout 20 bash -c "cd '$WORKER_DIR' && CI=true npx wrangler whoami </dev/null 2>&1" | grep -q "You are logged in"
}

logout_wrangler() {
  read -r -p "Hapus credential Wrangler? (y/N): " c
  [ "$c" = y ] || { echo "Batal."; return; }
  rm -rf /root/.wrangler /root/.config/.wrangler /root/.config/wrangler \
         /root/.npm/_npx /tmp/wrangler-* 2>/dev/null || true
  echo "Wrangler credential dihapus."
}

logout_tunnel() {
  read -r -p "Hapus credential CF Tunnel (cert.pem + semua credential tunnel)? (y/N): " c
  [ "$c" = y ] || { echo "Batal."; return; }
  systemctl stop cloudflared 2>/dev/null || true
  systemctl disable cloudflared 2>/dev/null || true
  cloudflared service uninstall 2>/dev/null || true
  rm -rf /root/.cloudflared /etc/cloudflared
  echo "CF Tunnel credential + service dihapus."
}

reset_all() {
  echo "PERINGATAN: Ini akan menghapus SEMUA credential dan state Cloudflare."
  echo "Service TempMail tetap jalan, data email tidak terhapus."
  read -r -p "Ketik RESET untuk konfirmasi: " c
  [ "$c" = "RESET" ] || { echo "Batal."; return; }
  logout_wrangler
  logout_tunnel
  rm -f "$STATE"
  echo '{}' > "$STATE"
  echo "Reset selesai. Jalankan menu 8 untuk setup ulang."
}


login_wrangler() {
  ensure_worker_tools
  if wrangler_logged_in; then
    echo "Wrangler sudah login."
    return
  fi
  run_login "Wrangler" bash -c "cd '$WORKER_DIR' && CI=true npx wrangler login --browser=false --device </dev/null"
  if wrangler_logged_in; then
    echo "Wrangler login OK."
  else
    echo "Wrangler belum login. Coba lagi (menu 3)."
  fi
}

tunnel_login() {
  echo "Tunnel hanya satu gateway. Login ke akun yang memiliki tunnel utama."
  if [ -f /root/.cloudflared/cert.pem ]; then
    echo "Sudah login (cert.pem ada). Skip."
  else
    run_login "CF Tunnel" cloudflared tunnel login
    [ -f /root/.cloudflared/cert.pem ] && echo "CF Tunnel login OK." || echo "cert.pem belum ada. Coba lagi."
  fi
  read -r -p "Label akun tunnel (contoh: CF A): " account
  CF_TUNNEL_ACCOUNT="${account:-logged in}" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['tunnel']['account']=os.environ['CF_TUNNEL_ACCOUNT']
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
}

create_tunnel() {
  local web_host list id tunnel_name
  read -r -p "Hostname web tunnel (contoh: mail.domain.com): " web_host
  [ -n "$web_host" ] || return
  tunnel_name="$TUNNEL_NAME"
  [ -f /root/.cloudflared/cert.pem ] || { echo "Login Tunnel dulu."; return; }
  list=$(cloudflared tunnel list --output json)
  id=$(python3 - "$tunnel_name" "$list" <<'PY'
import json,sys
for item in json.loads(sys.argv[2]):
  if item['name']==sys.argv[1]: print(item['id']); break
PY
)
  if [ -z "$id" ]; then
    cloudflared tunnel create "$tunnel_name"
    list=$(cloudflared tunnel list --output json)
    id=$(python3 - "$tunnel_name" "$list" <<'PY'
import json,sys
for item in json.loads(sys.argv[2]):
  if item['name']==sys.argv[1]: print(item['id']); break
PY
)
  fi
  [ -n "$id" ] || { echo "Tunnel gagal dibuat."; return; }
  cat >/etc/cloudflared/config.yml <<EOF
 tunnel: $id
 credentials-file: /root/.cloudflared/$id.json
 ingress:
   - hostname: $web_host
     service: http://127.0.0.1:$(app_port)
   - service: http_status:404
EOF
  sed -i 's/^ //' /etc/cloudflared/config.yml
  cloudflared tunnel route dns "$tunnel_name" "$web_host"
  cloudflared service install
  systemctl enable --now cloudflared
  CF_TUNNEL_ID="$id" CF_TUNNEL_NAME="$tunnel_name" CF_WEB_HOST="$web_host" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['tunnel'].update({'id':os.environ['CF_TUNNEL_ID'],'name':os.environ['CF_TUNNEL_NAME'],'web_host':os.environ['CF_WEB_HOST']})
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  echo "Tunnel siap: https://$web_host/app/"
}

deploy_worker() {
  local profile token account api_key copies
  profile=$(choose_profile) || return
  ensure_worker_tools
  token=$(profile_token "$profile")
  account=$(profile_account_id "$profile")
  api_key=$(grep '^EMAIL_API_KEY=' "$APP_ENV" | cut -d= -f2-)
  [ -n "$api_key" ] || { api_key=$(openssl rand -hex 32); set_app_env EMAIL_API_KEY "$api_key"; }
  copies=$(state_get_copy)
  local web_host
  web_host=$(state_get tunnel web_host)
  [ -n "$web_host" ] || { echo "Setup tunnel web dulu."; return; }
  (cd "$WORKER_DIR" && \
    export CLOUDFLARE_API_TOKEN="$token" CLOUDFLARE_ACCOUNT_ID="$account"; \
    CI=true npx wrangler deploy && \
    printf '%s\n' "https://$web_host" | CI=true npx wrangler secret put TEMPMAIL_SERVER_URL && \
    printf '%s\n' "$api_key" | CI=true npx wrangler secret put TEMPMAIL_API_KEY && \
    printf '%s\n' "$copies" | CI=true npx wrangler secret put FORWARD_LIST)
  CF_PROFILE="$profile" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['profiles'][os.environ['CF_PROFILE']]['worker_deployed']=True
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  echo "Worker profile $profile deployed. Salinan: ${copies:-OFF}"
}

delete_worker() {
  local profile token account
  profile=$(choose_profile) || return
  ensure_worker_tools
  token=$(profile_token "$profile")
  account=$(profile_account_id "$profile")
  read -r -p "Hapus worker tempmailbyjhopanstore dari Cloudflare? (y/N): " c
  [ "$c" = y ] || { echo "Batal."; return; }
  (cd "$WORKER_DIR" && \
    export CLOUDFLARE_API_TOKEN="$token" CLOUDFLARE_ACCOUNT_ID="$account"; \
    CI=true npx wrangler delete </dev/null)
  echo "Worker dihapus dari Cloudflare."
}

enable_routing_for_domain() {
  local domain item profile zid body
  read -r -p "Domain yang diaktifkan catch-all: " domain
  item=$(python3 - "$STATE" "$domain" <<'PY'
import json,sys
print(json.dumps(json.load(open(sys.argv[1]))['domains'].get(sys.argv[2],{})))
PY
)
  [ "$item" != '{}' ] || { echo "Domain tidak ada di menu domain."; return; }
  profile=$(printf '%s' "$item" | python3 -c 'import json,sys; print(json.load(sys.stdin)["profile"])')
  body='{"name":"TempMail catch-all","enabled":true,"actions":[{"type":"worker","value":["tempmailbyjhopanstore"]}],"matchers":[{"type":"all"}]}'
  zid=$(printf '%s' "$item" | python3 -c 'import json,sys; print(json.load(sys.stdin)["zone_id"])')
  cf_api "$profile" POST "/zones/$zid/email/routing/enable" '{}' >/dev/null || true
  cf_api "$profile" PUT "/zones/$zid/email/routing/rules/catch_all" "$body" >/dev/null
  CF_DOMAIN="$domain" python3 - "$STATE" <<'PY'
import json,os,sys
path=sys.argv[1]; d=json.load(open(path)); d['domains'][os.environ['CF_DOMAIN']]['enabled']=True; d['domains'][os.environ['CF_DOMAIN']]['routing']=True
open(path,'w').write(json.dumps(d,indent=2)+'\n')
PY
  refresh_app_domains
  echo "Routing aktif: *@$domain → Worker profile $profile → TempMail"
}

dashboard() {
  local service rss inboxes messages backup tunnel copy
  local host port api_key admin_email web_url
  local C_GREEN='\033[0;32m' C_RED='\033[0;31m' C_CYAN='\033[0;36m' C_YELLOW='\033[0;33m' C_BOLD='\033[1m' C_DIM='\033[2m' C_NC='\033[0m'
  service=$(systemctl is-active tempmail 2>/dev/null || true)
  rss=$(ps -o rss= -C tempmail 2>/dev/null | awk 'NR==1 {printf "%.1f MiB",$1/1024}')
  inboxes=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM inboxes;' 2>/dev/null || echo 0)
  messages=$(sqlite3 "$APP/data/tempmail.db" 'SELECT count(*) FROM messages;' 2>/dev/null || echo 0)
  backup=$(systemctl is-active tempmail-backup.timer 2>/dev/null || true)
  tunnel=$(systemctl is-active cloudflared 2>/dev/null || true)
  copy=$(state_get_copy); [ -n "$copy" ] || copy=OFF
  port=$(app_port)
  host=$(hostname -I | awk '{print $1}')
  api_key=$(grep '^EMAIL_API_KEY=' "$APP_ENV" 2>/dev/null | cut -d= -f2)
  admin_email=$(sqlite3 "$APP/data/tempmail.db" 'SELECT email FROM users WHERE role="admin" LIMIT 1;' 2>/dev/null || echo "belum")
  web_url=$(python3 -c "import json;d=json.load(open('$STATE'));print(d.get('tunnel',{}).get('web_host',''))" 2>/dev/null || echo "")
  local dom_val=$(python3 -c "import json;d=json.load(open('$STATE'));doms=list(d.get('domains',{}).keys());print(', '.join(doms) if doms else 'belum ada')" 2>/dev/null || echo "belum ada")
  local wrkr=$(python3 -c "import json;d=json.load(open('$STATE'));ap=d.get('active_profile','');p=d.get('profiles',{}).get(ap,{});print('✓ deployed' if p.get('worker_deployed') else '✗ belum')" 2>/dev/null || echo "✗ belum")
  local tun_name=$(python3 -c "import json;d=json.load(open('$STATE'));print(d.get('tunnel',{}).get('name','') or '')" 2>/dev/null || echo "")
  local tun_id=$(python3 -c "import json;d=json.load(open('$STATE'));print(d.get('tunnel',{}).get('id','') or '')" 2>/dev/null || echo "")
  local dom_count=$(python3 -c "import json;d=json.load(open('$STATE'));print(len(d.get('domains',{})))" 2>/dev/null || echo "0")
  local prof_count=$(python3 -c "import json;d=json.load(open('$STATE'));print(len(d.get('profiles',{})))" 2>/dev/null || echo "0")
  local active_prof=$(python3 -c "import json;d=json.load(open('$STATE'));print(d.get('active_profile','') or '')" 2>/dev/null || echo "")
  # Wrangler login status (check token file, not API call — faster + reliable)
  local wrangler_status="belum login"
  if [ -f /root/.wrangler/config/default.toml ]; then
    if grep -q "oauth_token" /root/.wrangler/config/default.toml 2>/dev/null; then
      wrangler_status="✓ login"
    fi
  elif [ -f /root/.config/.wrangler/config/default.toml ]; then
    if grep -q "oauth_token" /root/.config/.wrangler/config/default.toml 2>/dev/null; then
      wrangler_status="✓ login"
    fi
  fi
  # CF Tunnel login status
  local cf_cert_status="belum login"
  [ -f /root/.cloudflared/cert.pem ] && cf_cert_status="✓ login (cert.pem)"
  # Email routing status
  local routing_status="OFF"
  python3 -c "import json;d=json.load(open('$STATE'));doms=d.get('domains',{});routing_status='ON' if any(v.get('routing') for v in doms.values()) else 'OFF'" 2>/dev/null || true
  local routing_on=$(python3 -c "import json;d=json.load(open('$STATE'));doms=d.get('domains',{});print('ON' if any(v.get('routing') for v in doms.values()) else 'OFF')" 2>/dev/null || echo "OFF")

  # ── Dashboard ──
  echo
  echo -e "  ${C_BOLD}╔════════════════════════════════════════════╗${C_NC}"
  echo -e "  ${C_BOLD}║      ⚡ TempMail By JhopanStore            ║${C_NC}"
  echo -e "  ${C_BOLD}║         ${C_CYAN}Credit JhopanStore${C_NC}            ${C_BOLD}║${C_NC}"
  echo -e "  ${C_BOLD}╚════════════════════════════════════════════╝${C_NC}"
  echo
  printf "  ${C_DIM}%-16s${C_NC} %s / %s\n" "Platform" "$(. /etc/os-release; echo "$PRETTY_NAME")" "$(uname -m)"
  if [ "${service:-inactive}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC} | %s\n" "Service" "${service:-inactive}" "${rss:-0 MiB}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC} | %s\n" "Service" "${service:-inactive}" "${rss:-0 MiB}"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Admin" "$admin_email"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Domains" "$dom_val"
  printf "  ${C_DIM}%-16s${C_NC} ${C_CYAN}http://%s:%s/app/${C_NC}\n" "Web LAN" "$host" "$port"
  if [ -n "$web_url" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_CYAN}https://%s/app/${C_NC}\n" "Web Tunnel" "$web_url"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_DIM}belum di-setup${C_NC}\n" "Web Tunnel"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s inbox | %s message\n" "Inbox" "$inboxes" "$messages"
  if [ "${backup:-inactive}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "SQLite Backup" "${backup:-inactive}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "SQLite Backup" "${backup:-inactive}"
  fi
  printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "API Key" "$api_key"
  echo
  echo -e "  ${C_BOLD}─── Cloudflare (Tunnel) ───${C_NC}"
  if [ "${cf_cert_status#✓}" != "$cf_cert_status" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Login" "$cf_cert_status"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Login" "$cf_cert_status"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Tunnel Name" "${tun_name:-belum dibuat}"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Tunnel ID" "${tun_id:-belum dibuat}"
  if [ "${tunnel:-not configured}" = "active" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Tunnel Service" "${tunnel:-not configured}"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Tunnel Service" "${tunnel:-not configured}"
  fi
  if [ "$routing_on" = "ON" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Email Routing" "$routing_on"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Email Routing" "$routing_on"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Salinan Email" "$copy"
  echo
  echo -e "  ${C_BOLD}─── Wrangler (Worker) ───${C_NC}"
  if [ "${wrangler_status#✓}" != "$wrangler_status" ]; then
    printf "  ${C_DIM}%-16s${C_NC} ${C_GREEN}%s${C_NC}\n" "Login" "$wrangler_status"
  else
    printf "  ${C_DIM}%-16s${C_NC} ${C_RED}%s${C_NC}\n" "Login" "$wrangler_status"
  fi
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Active Profile" "${active_prof:-belum ada}"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Worker" "$wrkr"
  printf "  ${C_DIM}%-16s${C_NC} %s\n" "Profiles" "$prof_count profile"
  echo
}

